{
  "name": "tmy-tri-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:wiki": "tsc --noEmit && vite build --config vite.wiki.config.ts",
    "typecheck": "tsc --noEmit",
    "dev:wiki": "vite --config vite.wiki.config.ts",
    "test": "vitest run --exclude tests/ui.spec.ts --exclude tests/cloud.spec.ts",
    "test:ui": "playwright test",
    "format": "prettier --write src wiki tests *.ts *.json *.html",
    "format:check": "prettier --check src wiki tests *.ts *.json *.html",
    "test:cloud": "playwright test --config playwright.cloud.config.ts"
  },
  "dependencies": {
    "@tiptap/core": "^3.32.1",
    "@tiptap/extension-image": "^3.32.1",
    "@tiptap/extension-link": "^3.32.1",
    "@tiptap/extension-placeholder": "^3.32.1",
    "@tiptap/extension-table": "^3.32.1",
    "@tiptap/extension-underline": "^3.32.1",
    "@tiptap/pm": "^3.32.1",
    "@tiptap/react": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "antd-mobile": "^5.42.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
