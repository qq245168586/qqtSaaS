NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tmytri
DB_PASSWORD=
DB_NAME=tmy_tri_manager
JWT_SECRET=
INITIAL_ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# 仅本地 HTTP 开发设 false；生产 HTTPS 必须 true
COOKIE_SECURE=false
AI_API_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL_NAME=deepseek-chat
# 恢复前安全快照目录；生产设置受限目录，例如 /var/lib/tmy-phase2/backups
BACKUP_DIR=
ATTACHMENT_DIR=/var/lib/tmy-phase2/attachments
BASE_URL=https://114.215.185.184
# 用户明确授权的公网全局共享免密模式；false保留账号密码登录
PUBLIC_ACCESS=false

# 网页固定访问密码，仅服务端配置；空值不开启，桌面免密保持不变
WEB_ACCESS_PASSWORD=
